# Graphics Demo
# Demonstrates PLOT and screen positioning
10 CLS
20 PRINT "GRAPHICS DEMO - DRAWING RECTANGLE AND CROSS"
30 REM Draw horizontal lines
40 FOR X = 0 TO 79
50   PLOT X, 0
60   PLOT X, 39
70 NEXT X
80 REM Draw vertical lines
90 FOR Y = 0 TO 39
100   PLOT 0, Y
110   PLOT 79, Y
120 NEXT Y
130 REM Draw cross through center
140 FOR X = 0 TO 79
150   PLOT X, 20
160 NEXT X
170 FOR Y = 0 TO 39
180   PLOT 40, Y
190 NEXT Y
200 PRINT AT 21, 0; "DONE. PRESS ENTER TO CLEAR.";
210 INPUT A$
220 CLS
