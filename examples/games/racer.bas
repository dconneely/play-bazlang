10 REM ### Racer Game - Avoid the walls as the road twists and turns (80 x 25 window)
20 CLS
30 RAND
100 REM ### Initialise constants
110 LET TERM_WIDTH = 80
120 LET TERM_HEIGHT = 25
130 LET ROAD_WIDTH = 20
200 LET BLOCK_FULL$ = CHR$(9608)
210 LET BLOCK_LEFTH$ = CHR$(9612)
220 LET BLOCK_RIGHTH$ = CHR$(9616)
300 LET WALL$ = ""
310 LET SPACES$ = ""
320 FOR COL = 1 TO TERM_WIDTH
330 LET WALL$ = WALL$ + BLOCK_FULL$
340 LET SPACES$ = SPACES$ + " "
350 NEXT COL
1000 REM ### Re-initialise variables for new game
1010 DIM ROAD_HPOS(TERM_HEIGHT)
1020 LET ROAD_LEFT = (TERM_WIDTH - ROAD_WIDTH) / 2
1030 FOR ROW = 1 TO TERM_HEIGHT
1040 LET ROAD_HPOS(ROW) = ROAD_LEFT
1060 NEXT ROW
1070 LET CAR_HPOS = ROAD_LEFT + ROAD_WIDTH / 2 - 1
1080 LET CAR_VPOS = TERM_HEIGHT - 5
1090 LET SCORE = 0
1100 LET ROAD_CURVE = 0
2000 REM ### Main Loop
2010 LET K$ = INKEY$
2020 IF K$ = "a" OR K$ = "A" THEN LET CAR_HPOS = CAR_HPOS - 1
2030 IF K$ = "d" OR K$ = "D" THEN LET CAR_HPOS = CAR_HPOS + 1
3000 REM ### Update Road
3010 LET CHANCE = RND
3020 IF CHANCE < 0.15 THEN LET ROAD_CURVE = ROAD_CURVE - 0.3
3030 IF CHANCE >= 0.15 AND CHANCE < 0.4 THEN LET ROAD_CURVE = ROAD_CURVE - 0.15
3040 IF CHANCE >= 0.6 AND CHANCE < 0.85 THEN LET ROAD_CURVE = ROAD_CURVE + 0.15
3050 IF CHANCE >= 0.85 THEN LET ROAD_CURVE = ROAD_CURVE + 0.3
3060 IF ROAD_CURVE < -0.95 THEN LET ROAD_CURVE = -0.95
3070 IF ROAD_CURVE > 0.95 THEN LET ROAD_CURVE = 0.95
3080 LET ROAD_LEFT = ROAD_LEFT + ROAD_CURVE
3090 IF ROAD_LEFT < 2 THEN LET ROAD_CURVE = 0
3100 IF ROAD_LEFT < 2 THEN LET ROAD_LEFT = 2
3110 IF ROAD_LEFT > TERM_WIDTH - ROAD_WIDTH - 2 THEN LET ROAD_CURVE = 0
3120 IF ROAD_LEFT > TERM_WIDTH - ROAD_WIDTH - 2 THEN LET ROAD_LEFT = TERM_WIDTH - ROAD_WIDTH - 2
4000 REM ### Shift History (scroll down - new road at top)
4010 FOR ROW = TERM_HEIGHT TO 2 STEP -1
4020 LET ROAD_HPOS(ROW) = ROAD_HPOS(ROW-1)
4030 NEXT ROW
4040 LET ROAD_HPOS(1) = ROAD_LEFT
5000 REM ### Move car up as score increases (less reaction time)
5010 LET CAR_VPOS = TERM_HEIGHT - 5 - INT(SCORE / 500)
5020 IF CAR_VPOS < 3 THEN LET CAR_VPOS = 3
6000 REM ### Collision check
6010 LET ROAD_HPOS_NOW = ROAD_HPOS(CAR_VPOS + 1)
6020 IF CAR_HPOS < ROAD_HPOS_NOW OR (CAR_HPOS + 3) > (ROAD_HPOS_NOW + ROAD_WIDTH) THEN GOTO 9000
7000 REM ### Draw road (top row, 0, shows the score and instructions)
7010 FOR ROW = 1 TO TERM_HEIGHT - 1
7020 LET LI = ROAD_HPOS(ROW+1)
7030 LET IL = INT(LI)
7040 LET FRAC = LI - IL
7050 PRINT AT ROW, 0; WALL$(1 TO IL);
7060 IF FRAC < 0.5 THEN PRINT " ";
7070 IF FRAC >= 0.5 THEN PRINT BLOCK_LEFTH$;
7080 LET RW = ROAD_WIDTH - 1
7090 LET DASH$ = " "
7100 IF (SCORE + ROW) / 2 = INT((SCORE + ROW) / 2) THEN LET DASH$ = "|"
7110 LET MW = INT(RW / 2)
7120 PRINT SPACES$(1 TO MW); DASH$; SPACES$(1 TO RW - MW - 1);
7130 IF FRAC < 0.5 THEN PRINT BLOCK_FULL$;
7140 IF FRAC >= 0.5 THEN PRINT BLOCK_RIGHTH$;
7150 PRINT WALL$(1 TO TERM_WIDTH - (IL + RW + 2));
7160 NEXT ROW
8000 REM ### Draw car and score
8010 PRINT AT CAR_VPOS, CAR_HPOS; "|H|"; AT CAR_VPOS + 1, CAR_HPOS; " ¯ ";
8020 PRINT AT 0, 1; " SCORE: "; SCORE; " "; AT 0, TERM_WIDTH - 19; " STEER WITH A & D ";
8030 LET SCORE = SCORE + 5 + INT(ABS(ROAD_CURVE) * 5)
8040 GOTO 2000
9000 REM ### Game Over
9010 PRINT AT TERM_HEIGHT - 4, 0; "CRASH! FINAL SCORE: "; SCORE
9020 IF SCORE < 500 THEN PRINT "Did you forget your glasses?"
9030 IF SCORE >= 500 AND SCORE < 1500 THEN PRINT "Not bad for a learner!"
9040 IF SCORE >= 1500 AND SCORE < 2500 THEN PRINT "Getting the hang of it!"
9050 IF SCORE >= 2500 AND SCORE < 3500 THEN PRINT "Vroom vroom! Professional driver!"
9060 IF SCORE >= 3500 AND SCORE < 5000 THEN PRINT "Speed demon! Almost there!"
9070 IF SCORE >= 5000 THEN PRINT "Formula 1 Champion!"
9080 PRINT AT TERM_HEIGHT - 2, 0; "Play again? (Y/N) ";
9100 LET K$ = INKEY$
9110 IF K$ = "Y" OR K$ = "y" THEN GOTO 1000
9120 IF K$ = "N" OR K$ = "n" THEN STOP
9130 GOTO 9100
