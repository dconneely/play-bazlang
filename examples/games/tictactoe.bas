# Tic-Tac-Toe
# Play against the computer
10 DIM B(9)
20 PRINT "TIC-TAC-TOE"
30 PRINT "==========="
40 PRINT
50 PRINT "You are X, Computer is O"
60 PRINT
70 REM Initialise board
80 FOR I = 1 TO 9
90   LET B(I) = 0
100 NEXT I
110 LET MOVES = 0
120 REM Main game loop
130 GOSUB 500
140 IF MOVES = 9 THEN GOTO 450
150 REM Player move
160 PRINT "Your move (1-9): ";
170 INPUT M
180 IF M < 1 OR M > 9 THEN GOTO 160
190 IF B(M) <> 0 THEN PRINT "Square taken!"
191 IF B(M) <> 0 THEN GOTO 160
200 LET B(M) = 1
210 LET MOVES = MOVES + 1
220 GOSUB 500
230 GOSUB 650
240 IF W = 1 THEN PRINT "You win!"
241 IF W = 1 THEN GOTO 460
250 IF MOVES = 9 THEN GOTO 450
260 REM Computer move
270 PRINT "Computer thinking..."
280 GOSUB 840
290 LET B(CM) = 2
300 LET MOVES = MOVES + 1
310 PRINT "Computer plays "; CM
320 GOSUB 500
330 GOSUB 650
340 IF W = 2 THEN PRINT "Computer wins!"
341 IF W = 2 THEN GOTO 460
350 GOTO 130
450 PRINT "It's a draw!"
460 PRINT "Play again (Y/N)? ";
470 INPUT A$
480 IF A$ = "Y" OR A$ = "y" THEN GOTO 70
490 STOP
500 REM Display board
510 PRINT
520 FOR R = 0 TO 2
530   FOR C = 1 TO 3
540     LET P = R * 3 + C
550     IF B(P) = 0 THEN PRINT " "; P;
560     IF B(P) = 1 THEN PRINT " X";
570     IF B(P) = 2 THEN PRINT " O";
580     IF C < 3 THEN PRINT " |";
590   NEXT C
600   PRINT
610   IF R < 2 THEN PRINT "-----------"
620 NEXT R
630 PRINT
640 RETURN
650 REM Check for winner
660 LET W = 0
670 REM Check rows
680 FOR R = 0 TO 2
690   LET S = R * 3 + 1
700   IF B(S) = 0 THEN GOTO 730
710   IF B(S) = B(S+1) AND B(S) = B(S+2) THEN LET W = B(S)
720   IF W <> 0 THEN RETURN
730 NEXT R
740 REM Check columns
750 FOR C = 1 TO 3
760   IF B(C) = 0 THEN GOTO 790
770   IF B(C) = B(C+3) AND B(C) = B(C+6) THEN LET W = B(C)
780   IF W <> 0 THEN RETURN
790 NEXT C
800 REM Check diagonals
810 IF B(1) <> 0 AND B(1) = B(5) AND B(1) = B(9) THEN LET W = B(1)
820 IF B(3) <> 0 AND B(3) = B(5) AND B(3) = B(7) THEN LET W = B(3)
830 RETURN
840 REM Computer AI
850 LET CM = 0
860 REM Try to win
870 FOR I = 1 TO 9
880   IF B(I) <> 0 THEN GOTO 895
881   GOSUB 1000
882   IF CW = 1 THEN LET CM = I
883   IF CW = 1 THEN RETURN
895 NEXT I
900 REM Block player
910 FOR I = 1 TO 9
920   IF B(I) <> 0 THEN GOTO 935
921   GOSUB 1100
922   IF CP = 1 THEN LET CM = I
923   IF CP = 1 THEN RETURN
935 NEXT I
940 REM Take centre
950 IF B(5) = 0 THEN LET CM = 5
951 IF B(5) = 0 THEN RETURN
960 REM Take first available
970 FOR I = 1 TO 9
980   IF B(I) = 0 THEN LET CM = I
981   IF B(I) = 0 THEN RETURN
990 NEXT I
991 RETURN
1000 REM Check if move wins
1010 LET CW = 0
1020 LET B(I) = 2
1030 GOSUB 650
1040 IF W = 2 THEN LET CW = 1
1050 LET B(I) = 0
1060 LET W = 0
1070 RETURN
1100 REM Check if blocks
1110 LET CP = 0
1120 LET B(I) = 1
1130 GOSUB 650
1140 IF W = 1 THEN LET CP = 1
1150 LET B(I) = 0
1160 LET W = 0
1170 RETURN
