# Connect 4 - A two-player connection game
# Human vs Computer
# Use number keys 1-7 to drop a piece in that column

10 DIM B(6, 7)
20 CLS
30 LET HUMAN = 0
40 PRINT "CONNECT 4"
50 PRINT
60 PRINT "[Y]ellow - play first"
70 PRINT "[R]ed - play second"
80 PRINT "[S]top - end game"
90 PRINT
100 PRINT "Choose: ";
110 LET K$ = INKEY$
120 IF K$ = "S" OR K$ = "s" THEN STOP
130 IF K$ = "Y" OR K$ = "y" THEN LET HUMAN = 1
140 IF K$ = "R" OR K$ = "r" THEN LET HUMAN = 2
150 IF HUMAN = 0 THEN GOTO 110
160 PRINT K$
170 CLS
180 GOSUB 2430
190 LET TURN = 1
200 LET MOVES = 0

# Main game loop
210 GOSUB 450
220 IF TURN = HUMAN THEN GOSUB 590
230 IF TURN <> HUMAN THEN GOSUB 680
240 IF COL = 0 THEN GOTO 210
250 GOSUB 1410
260 GOSUB 1530
270 IF WIN = 1 THEN GOTO 320
280 LET MOVES = MOVES + 1
290 IF MOVES = 42 THEN GOTO 380
300 LET TURN = 3 - TURN
310 GOTO 210

# Win announcement
320 GOSUB 450
330 PRINT AT 12, 0; "                                        "
340 IF TURN = HUMAN THEN PRINT AT 12, 0; "*** YOU WIN! ***"
350 IF TURN <> HUMAN THEN PRINT AT 12, 0; "*** COMPUTER WINS! ***"
360 GOSUB 420
370 GOTO 20

# Draw announcement
380 GOSUB 450
390 PRINT AT 12, 0; "*** IT'S A DRAW! ***"
400 GOSUB 420
410 GOTO 20

# Allow user to read game end announcement
420 PRINT AT 14, 0; "Press ENTER to continue...";
430 INPUT A$
440 RETURN

# Draw the board
450 PRINT AT 1, 0; "  1    2    3    4    5    6    7"
460 PRINT AT 2, 0; "┌────┬────┬────┬────┬────┬────┬────┐"
470 FOR R = 1 TO 6
480 LET Y = R + 2
490 PRINT AT Y, 0; "│";
500 FOR C = 1 TO 7
510 LET V = B(R, C)
520 IF V = 0 THEN PRINT " 🔵 │";
530 IF V = 1 THEN PRINT " 🟡 │";
540 IF V = 2 THEN PRINT " 🔴 │";
550 NEXT C
560 NEXT R
570 PRINT AT 9, 0; "└────┴────┴────┴────┴────┴────┴────┘"
580 RETURN

# Human turn
590 PRINT AT 11, 0; "                                        "
600 IF HUMAN = 1 THEN PRINT AT 11, 0; "Your turn (🟡). Column (1-7): ";
610 IF HUMAN = 2 THEN PRINT AT 11, 0; "Your turn (🔴). Column (1-7): ";
620 LET K$ = INKEY$
630 IF K$ < "1" OR K$ > "7" THEN GOTO 620
640 LET COL = VAL K$
650 PRINT K$
660 IF B(1, COL) <> 0 THEN GOTO 590
670 RETURN

# Computer turn
680 PRINT AT 11, 0; "                                        "
690 PRINT AT 11, 0; "Computer thinking..."
700 LET COMP = TURN
710 LET OPP = 3 - TURN

# Check for winning move
720 FOR CC = 1 TO 7
730 IF B(1, CC) <> 0 THEN GOTO 810
740 LET C = CC
750 GOSUB 1350
760 LET B(TR, CC) = COMP
770 GOSUB 1530
780 LET B(TR, CC) = 0
790 IF WIN = 1 THEN LET COL = CC
800 IF WIN = 1 THEN RETURN
810 NEXT CC

# Block human winning move
820 FOR CC = 1 TO 7
830 IF B(1, CC) <> 0 THEN GOTO 910
840 LET C = CC
850 GOSUB 1350
860 LET B(TR, CC) = OPP
870 GOSUB 1530
880 LET B(TR, CC) = 0
890 IF WIN = 1 THEN LET COL = CC
900 IF WIN = 1 THEN RETURN
910 NEXT CC

920 FOR CC = 1 TO 7
930 IF B(1, CC) <> 0 THEN GOTO 1020
940 LET C = CC
950 GOSUB 1350
960 LET B(TR, CC) = COMP
970 LET THREATS = 0
980 GOSUB 1830
990 LET B(TR, CC) = 0
1000 IF THREATS >= 2 THEN LET COL = CC
1010 IF THREATS >= 2 THEN RETURN
1020 NEXT CC

1030 FOR CC = 1 TO 7
1040 IF B(1, CC) <> 0 THEN GOTO 1130
1050 LET C = CC
1060 GOSUB 1350
1070 LET B(TR, CC) = OPP
1080 LET THREATS = 0
1090 GOSUB 1830
1100 LET B(TR, CC) = 0
1110 IF THREATS >= 2 THEN LET COL = CC
1120 IF THREATS >= 2 THEN RETURN
1130 NEXT CC

1140 LET BEST = 0
1150 LET BESTSCORE = -100
1160 FOR CC = 1 TO 7
1170 IF B(1, CC) <> 0 THEN GOTO 1320
1180 LET C = CC
1190 GOSUB 1350
1200 LET SCORE = 10 - ABS(CC - 4)
1210 IF TR > 1 THEN LET B(TR - 1, CC) = OPP
1220 IF TR > 1 THEN GOSUB 1530
1230 IF TR > 1 THEN LET B(TR - 1, CC) = 0
1240 IF TR > 1 AND WIN = 1 THEN LET SCORE = SCORE - 50
1250 LET B(TR, CC) = COMP
1260 LET THREATS = 0
1270 GOSUB 1830
1280 LET B(TR, CC) = 0
1290 LET SCORE = SCORE + THREATS * 3
1300 IF SCORE > BESTSCORE THEN LET BESTSCORE = SCORE
1310 IF SCORE > BESTSCORE - 1 THEN LET BEST = CC
1320 NEXT CC
1330 LET COL = BEST
1340 RETURN

# Find target row for column C
# Sets TR to the lowest empty row in column C
1350 LET TR = 0
1360 FOR R = 6 TO 1 STEP -1
1370 IF B(R, C) = 0 THEN LET TR = R
1380 IF TR > 0 THEN RETURN
1390 NEXT R
1400 RETURN

# Animate piece drop
1410 LET C = COL
1420 GOSUB 1350
1430 LET P$ = "🟡"
1440 IF TURN = 2 THEN LET P$ = "🔴"
1450 FOR R = 1 TO TR
1460 LET Y = R + 2
1470 PRINT AT Y, COL * 5 - 4; " "; P$; " "
1480 PAUSE 2
1490 IF R < TR THEN PRINT AT Y, COL * 5 - 4; " 🔵 "
1500 NEXT R
1510 LET B(TR, COL) = TURN
1520 RETURN

# Check for win
1530 LET WIN = 0

# Check horizontal
1540 FOR R = 1 TO 6
1550 FOR C = 1 TO 4
1560 IF B(R, C) = 0 THEN GOTO 1590
1570 IF B(R, C) = B(R, C + 1) AND B(R, C) = B(R, C + 2) AND B(R, C) = B(R, C + 3) THEN LET WIN = 1
1580 IF WIN = 1 THEN RETURN
1590 NEXT C
1600 NEXT R

# Check vertical
1610 FOR R = 1 TO 3
1620 FOR C = 1 TO 7
1630 IF B(R, C) = 0 THEN GOTO 1660
1640 IF B(R, C) = B(R + 1, C) AND B(R, C) = B(R + 2, C) AND B(R, C) = B(R + 3, C) THEN LET WIN = 1
1650 IF WIN = 1 THEN RETURN
1660 NEXT C
1670 NEXT R

# Check diagonal (down-right)
1680 FOR R = 1 TO 3
1690 FOR C = 1 TO 4
1700 IF B(R, C) = 0 THEN GOTO 1730
1710 IF B(R, C) = B(R + 1, C + 1) AND B(R, C) = B(R + 2, C + 2) AND B(R, C) = B(R + 3, C + 3) THEN LET WIN = 1
1720 IF WIN = 1 THEN RETURN
1730 NEXT C
1740 NEXT R

# Check diagonal (down-left)
1750 FOR R = 1 TO 3
1760 FOR C = 4 TO 7
1770 IF B(R, C) = 0 THEN GOTO 1800
1780 IF B(R, C) = B(R + 1, C - 1) AND B(R, C) = B(R + 2, C - 2) AND B(R, C) = B(R + 3, C - 3) THEN LET WIN = 1
1790 IF WIN = 1 THEN RETURN
1800 NEXT C
1810 NEXT R

1820 RETURN

1830 LET THREATS = 0
1840 FOR RR = 1 TO 6
1850 FOR CCC = 1 TO 4
1860 LET CNT = 0
1870 LET EMP = 0
1880 FOR K = 0 TO 3
1890 IF B(RR, CCC + K) = COMP THEN LET CNT = CNT + 1
1900 IF B(RR, CCC + K) = 0 THEN LET EMP = EMP + 1
1910 NEXT K
1920 IF CNT = 3 AND EMP = 1 THEN GOSUB 2230
1930 NEXT CCC
1940 NEXT RR

1950 FOR RR = 1 TO 3
1960 FOR CCC = 1 TO 7
1970 IF B(RR, CCC) = 0 AND B(RR + 1, CCC) = COMP AND B(RR + 2, CCC) = COMP AND B(RR + 3, CCC) = COMP THEN LET THREATS = THREATS + 1
1980 NEXT CCC
1990 NEXT RR

2000 FOR RR = 1 TO 3
2010 FOR CCC = 1 TO 4
2020 LET CNT = 0
2030 LET EMP = 0
2040 FOR K = 0 TO 3
2050 IF B(RR + K, CCC + K) = COMP THEN LET CNT = CNT + 1
2060 IF B(RR + K, CCC + K) = 0 THEN LET EMP = EMP + 1
2070 NEXT K
2080 IF CNT = 3 AND EMP = 1 THEN GOSUB 2290
2090 NEXT CCC
2100 NEXT RR

2110 FOR RR = 1 TO 3
2120 FOR CCC = 4 TO 7
2130 LET CNT = 0
2140 LET EMP = 0
2150 FOR K = 0 TO 3
2160 IF B(RR + K, CCC - K) = COMP THEN LET CNT = CNT + 1
2170 IF B(RR + K, CCC - K) = 0 THEN LET EMP = EMP + 1
2180 NEXT K
2190 IF CNT = 3 AND EMP = 1 THEN GOSUB 2360
2200 NEXT CCC
2210 NEXT RR
2220 RETURN

2230 FOR K = 0 TO 3
2240 IF B(RR, CCC + K) = 0 THEN LET ECOL = CCC + K
2250 NEXT K
2260 IF RR = 6 THEN LET THREATS = THREATS + 1
2270 IF RR < 6 AND B(RR + 1, ECOL) <> 0 THEN LET THREATS = THREATS + 1
2280 RETURN

2290 FOR K = 0 TO 3
2300 IF B(RR + K, CCC + K) = 0 THEN LET EROW = RR + K
2310 IF B(RR + K, CCC + K) = 0 THEN LET ECOL = CCC + K
2320 NEXT K
2330 IF EROW = 6 THEN LET THREATS = THREATS + 1
2340 IF EROW < 6 AND B(EROW + 1, ECOL) <> 0 THEN LET THREATS = THREATS + 1
2350 RETURN

2360 FOR K = 0 TO 3
2370 IF B(RR + K, CCC - K) = 0 THEN LET EROW = RR + K
2380 IF B(RR + K, CCC - K) = 0 THEN LET ECOL = CCC - K
2390 NEXT K
2400 IF EROW = 6 THEN LET THREATS = THREATS + 1
2410 IF EROW < 6 AND B(EROW + 1, ECOL) <> 0 THEN LET THREATS = THREATS + 1
2420 RETURN

# Initialise board
2430 FOR R = 1 TO 6
2440 FOR C = 1 TO 7
2450 LET B(R, C) = 0
2460 NEXT C
2470 NEXT R
2480 RETURN
