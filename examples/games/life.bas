# Game of Life
# Conway's cellular automaton simulation
10 REM Game of Life (Full Screen & Edit)
20 LET W = 160
30 LET H = 50
40 DIM C(160,50)
50 DIM N(160,50)
52 DIM LX(160)
54 DIM RX(160)
56 DIM UY(50)
58 DIM DY(50)
60 REM Init Lookups
62 FOR I = 1 TO W
64 LET LX(I) = I - 1
66 LET RX(I) = I + 1
68 NEXT I
70 LET LX(1) = W
72 LET RX(W) = 1
74 FOR I = 1 TO H
76 LET UY(I) = I - 1
78 LET DY(I) = I + 1
80 NEXT I
82 LET UY(1) = H
84 LET DY(H) = 1
90 REM Init R-pentomino at 80,25
92 LET CX = 80
94 LET CY = 25
96 LET C(CX, CY) = 1
98 LET C(CX+1, CY) = 1
100 LET C(CX-1, CY+1) = 1
102 LET C(CX, CY+1) = 1
104 LET C(CX, CY+2) = 1
140 REM Initial Draw
150 FOR Y = 1 TO H
160 FOR X = 1 TO W
170 IF C(X,Y) = 1 THEN PLOT X-1, Y-1
180 NEXT X
190 NEXT Y
200 LET G = 0
300 REM Generation Loop
310 PRINT AT 0, 0; "GENERATION: "; G; "  (PRESS E TO EDIT)"
320 FOR Y = 1 TO H
322 LET U = UY(Y)
324 LET D = DY(Y)
330 FOR X = 1 TO W
352 LET L = LX(X)
354 LET R = RX(X)
360 LET S = C(L, U) + C(X, U) + C(R, U) + C(L, Y) + C(R, Y) + C(L, D) + C(X, D) + C(R, D)
480 LET V = (S = 3) OR (S = 2 AND C(X,Y))
510 LET N(X,Y) = V
520 IF V = C(X,Y) THEN GOTO 550
530 IF V = 1 THEN PLOT X-1, Y-1
540 IF V = 0 THEN UNPLOT X-1, Y-1
550 NEXT X
560 NEXT Y
570 REM Update State
580 FOR Y = 1 TO H
590 FOR X = 1 TO W
600 LET C(X,Y) = N(X,Y)
610 NEXT X
620 NEXT Y
630 LET G = G + 1
634 LET K$ = INKEY$
635 IF K$ = "" THEN GOTO 300
636 IF K$ = "e" OR K$ = "E" THEN GOSUB 1000
640 GOTO 300
1000 REM Edit Mode
1002 REM Drain key buffer (key-repeat may have queued multiple E presses)
1004 LET K$ = INKEY$
1006 IF K$ <> "" THEN GOTO 1004
1010 LET KX = 80
1020 LET KY = 25
1030 PRINT AT 0, 0; "EDIT: W/A/S/D MOVE, - CLEAR, + SET, E RUN"
1040 LET K$ = INKEY$
1045 IF K$ <> "" THEN GOTO 1120
1050 IF C(KX, KY) = 1 THEN UNPLOT KX-1, KY-1
1060 IF C(KX, KY) = 0 THEN PLOT KX-1, KY-1
1070 PAUSE 5
1080 IF C(KX, KY) = 1 THEN PLOT KX-1, KY-1
1090 IF C(KX, KY) = 0 THEN UNPLOT KX-1, KY-1
1100 PAUSE 5
1110 GOTO 1040
1120 IF K$ = "w" OR K$ = "W" THEN LET KY = DY(KY)
1130 IF K$ = "s" OR K$ = "S" THEN LET KY = UY(KY)
1140 IF K$ = "a" OR K$ = "A" THEN LET KX = LX(KX)
1150 IF K$ = "d" OR K$ = "D" THEN LET KX = RX(KX)
1160 IF K$ = "+" OR K$ = "=" THEN GOTO 1200
1165 IF K$ = "-" OR K$ = "_" THEN GOTO 1250
1170 IF K$ = "e" OR K$ = "E" THEN GOTO 1300
1180 GOTO 1040
1200 REM Set
1220 LET C(KX, KY) = 1
1230 PLOT KX-1, KY-1
1240 GOTO 1040
1250 REM Clear
1255 LET C(KX, KY) = 0
1260 UNPLOT KX-1, KY-1
1270 GOTO 1040
1300 REM Exit Edit
1310 PRINT AT 0, 0; "GENERATION: "; G; "  (PRESS E TO EDIT)      "
1320 RETURN
