{
  // Full default ruleset, not just MD013/MD024 - matches doc-kit's and the identigon repos' own
  // .markdownlint-cli2.jsonc, and this repo's prior .markdownlint.yaml already ran the full set too
  // (markdownlint-cli's "default" key defaults to true when omitted, same as markdownlint-cli2's).
  // "default" is stated explicitly here rather than left implicit, for the same reason doc-kit
  // states it: a reader shouldn't have to know that omission-means-true rule to see the ruleset.
  //
  // MD013: matches the 100-column wrap AGENTS.md states as this repo's convention. Tables and code
  // blocks are exempt because neither can be wrapped without corrupting it; headings are exempt
  // because a heading is one line by construction - the only fix would be a rename, which is not
  // this tool's job.
  //
  // MD024: siblings_only, because CHANGELOG.md repeating "### Added" under each version heading is
  // the format Keep a Changelog prescribes, not a duplication bug.
  //
  // No "globs" key, deliberately - unlike doc-kit's copy of this file. With one set,
  // markdownlint-cli2 scans it in addition to whatever file list its caller passes, confirmed
  // directly: even an explicit `markdownlint-cli2 AGENTS.md` still swept the whole tree once
  // "globs": ["**/*.md"] was present, surfacing localonly-JLINE-SOURCE/ (gitignored vendored
  // source) and .agents/ (gitignored local skill notes) - neither ever meant to be linted. Omitting
  // "globs" leaves the pre-commit hook's own file list (tracked/staged Markdown only) authoritative,
  // matching identigon/identigon's and identigon.github.io's own copies of this file, which omit it
  // for the same reason.
  "config": {
    "default": true,
    "MD013": {
      "line_length": 100,
      "code_blocks": false,
      "tables": false,
      "headings": false
    },
    "MD024": {
      "siblings_only": true
    }
  }
}
