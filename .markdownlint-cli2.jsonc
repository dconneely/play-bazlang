{
  // Full default ruleset, not just MD013. "default" is stated explicitly rather than left
  // implicit - a reader shouldn't have to know that omission-means-true rule to see the ruleset.
  //
  // MD013: matches the 100-column wrap AGENTS.md states as this repo's convention. printWidth in
  // .prettierrc.json MUST match this line_length - change one, change both. Tables and code
  // blocks are exempt (neither can be wrapped without corrupting it); headings are exempt (one
  // line by construction). `stern` closes the gap non-strict mode leaves open: an ordinary prose
  // line with one long trailing word is otherwise silently forgiven, though a line that is purely
  // one unbreakable token (a bare URL alone) is still exempt.
  //
  // MD024: siblings_only, because CHANGELOG.md repeating "### Added" under each version heading is
  // the format Keep a Changelog prescribes, not a duplication bug.
  //
  // No "globs" key: with one set, markdownlint-cli2 scans it IN ADDITION to whatever file list its
  // caller passes - even an explicit `markdownlint-cli2 AGENTS.md` sweeps the whole tree, surfacing
  // gitignored directories never meant to be linted. Omitting it leaves the pre-commit hook's own
  // file list (tracked/staged Markdown only) authoritative.
  "config": {
    "default": true,
    "MD013": {
      "line_length": 100,
      "code_blocks": false,
      "tables": false,
      "headings": false,
      "stern": true
    },
    "MD024": {
      "siblings_only": true
    }
  }
}
