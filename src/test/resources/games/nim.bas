# ADVANCED 3-PILE NIM
10 DIM P(3)
20 LET P(1)=3
30 LET P(2)=5
40 LET P(3)=7
50 CLS
60 PRINT "THE GAME OF 3-PILE NIM"
70 PRINT "======================"
80 PRINT
90 GOSUB 500
100 REM PLAYER MOVE
110 PRINT "YOUR TURN."
120 PRINT "WHICH PILE (1-3)? ";
130 INPUT L
140 IF L<1 OR L>3 THEN GOTO 120
150 IF P(L)=0 THEN GOTO 120
160 PRINT "HOW MANY STICKS TO TAKE? ";
170 INPUT T
180 IF T<1 OR T>P(L) THEN GOTO 160
190 LET P(L)=P(L)-T
200 GOSUB 800
210 IF W=1 THEN GOTO 450
220 REM COMPUTER MOVE
230 CLS
240 GOSUB 500
250 PRINT "COMPUTER IS THINKING..."
260 GOSUB 600
270 PRINT "COMPUTER TAKES ";CT;" FROM PILE ";CL;"."
280 LET P(CL)=P(CL)-CT
290 PAUSE 100
300 GOSUB 800
310 IF W=1 THEN GOTO 470
320 GOTO 50
450 PRINT "YOU TOOK THE LAST STICK!"
460 PRINT "COMPUTER WINS."
465 GOTO 480
470 PRINT "COMPUTER TOOK THE LAST STICK!"
475 PRINT "YOU WIN!"
480 PRINT "PLAY AGAIN (Y/N)? ";
490 INPUT A$
495 IF A$="Y" OR A$="y" THEN GOTO 20
498 PRINT "THANKS FOR PLAYING!"
499 STOP
500 REM SUBROUTINE DRAW PILES
510 FOR I=1 TO 3
520 PRINT "PILE ";I;": ";
530 IF P(I)=0 THEN GOTO 570
540 FOR J=1 TO P(I)
550 PRINT "|";
560 NEXT J
570 PRINT " (";P(I);")"
580 NEXT I
590 PRINT
595 RETURN
600 REM SUBROUTINE AI NIM-SUM
610 LET S=0
620 FOR I=1 TO 3
630 LET A=S
640 LET B=P(I)
650 GOSUB 900
660 LET S=X
670 NEXT I
680 IF S<>0 THEN GOTO 730
690 FOR I=1 TO 3
700 IF P(I)>0 THEN LET CL=I
710 IF P(I)>0 THEN LET CT=1
720 NEXT I
725 RETURN
730 REM FIND MOVE
740 FOR I=1 TO 3
750 LET A=P(I)
760 LET B=S
770 GOSUB 900
780 IF X<P(I) THEN LET CL=I
790 IF X<P(I) THEN LET CT=P(I)-X
800 NEXT I
810 REM SPECIAL CASE FOR MISERE
820 LET C1=0
830 FOR I=1 TO 3
840 IF P(I)>0 THEN LET C1=C1+1
850 NEXT I
860 IF C1>1 THEN RETURN
870 REM END GAME LOGIC
880 LET CT=P(CL)
890 IF P(CL)>1 THEN LET CT=P(CL)-1
895 RETURN
800 REM SUBROUTINE CHECK FOR END GAME
810 LET W=0
820 IF P(1)=0 AND P(2)=0 AND P(3)=0 THEN LET W=1
830 RETURN
900 REM SUBROUTINE XOR A AND B INTO X
910 LET X=0
920 LET D=1
930 LET T1=A
940 LET T2=B
950 IF T1=0 AND T2=0 THEN RETURN
960 LET R1=T1-INT(T1/2)*2
970 LET R2=T2-INT(T2/2)*2
980 IF R1<>R2 THEN LET X=X+D
990 LET T1=INT(T1/2)
1000 LET T2=INT(T2/2)
1010 LET D=D*2
1020 GOTO 950
