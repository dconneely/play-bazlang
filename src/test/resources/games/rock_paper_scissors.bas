# Rock Paper Scissors
# Classic game against the computer
5 RAND 0
10 PRINT "ROCK, PAPER, SCISSORS"
20 PRINT "1=ROCK, 2=PAPER, 3=SCISSORS"
30 PRINT "YOUR CHOICE? ";
40 INPUT P
50 IF P < 1 OR P > 3 THEN GOTO 30
60 LET C = INT(RND * 3) + 1
70 PRINT "COMPUTER CHOSE ";
80 IF C = 1 THEN PRINT "ROCK"
90 IF C = 2 THEN PRINT "PAPER"
100 IF C = 3 THEN PRINT "SCISSORS"
110 IF P = C THEN PRINT "IT'S A TIE!"
120 IF (P=1 AND C=3) OR (P=2 AND C=1) OR (P=3 AND C=2) THEN PRINT "YOU WIN!"
130 IF (C=1 AND P=3) OR (C=2 AND P=1) OR (C=3 AND P=2) THEN PRINT "YOU LOSE!"
140 PRINT "PLAY AGAIN (Y/N)? ";
150 INPUT A$
160 IF A$ = "Y" OR A$ = "y" THEN GOTO 10
