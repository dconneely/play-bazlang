# Lunar Lander
# Land the spacecraft safely on the moon
5 RAND 0
10 LET H=150+INT(RND*100)
20 LET V=-10-INT(RND*10)
30 LET F=100
40 LET G=1.4+(RND*0.4)
50 LET BM=40
60 CLS
70 GOSUB 400
80 PRINT AT 3,0;"BURN FUEL (0-";F;")? ";
90 INPUT B
100 IF B<0 THEN LET B=0
110 IF B>F THEN LET B=F
120 LET F=F-B
130 REM ENGINE POWER VARIANCE
140 LET P=110+(RND*10)
150 LET A=(B*P/(BM+F))-G
160 LET H=H+V+(A/2)
170 LET V=V+A
180 IF H>0 THEN GOTO 60
190 CLS
200 LET H=0
210 GOSUB 400
220 PRINT AT 4,0;"LANDED!"
230 LET V=ABS(V)
240 PRINT AT 5,0;"IMPACT VELOCITY: ";V
250 IF V<2 THEN PRINT AT 6,0;"PERFECT LANDING!"
260 IF V>=2 AND V<8 THEN PRINT AT 6,0;"GOOD LANDING."
270 IF V>=8 THEN PRINT AT 6,0;"YOU CRASHED!"
280 PRINT AT 8,0;"PLAY AGAIN (Y/N)? ";
290 INPUT R$
300 IF R$="Y" OR R$="y" THEN GOTO 10
310 STOP
400 REM SUBROUTINE: DRAW DISPLAY
410 PRINT AT 0,0;"ALT:  ";INT(H);" M"
420 PRINT AT 0,20;"VEL:  ";INT(V);" M/S"
430 PRINT AT 1,0;"FUEL: ";F;" KG"
440 PRINT AT 1,20;"GRAV: ";INT(G*100)/100;" M/S2"
450 GOSUB 600
460 REM LANDER POSITION
470 LET R=18-INT(H/15)
480 IF R<4 THEN LET R=4
490 IF R>18 THEN LET R=18
500 PRINT AT R,20;"  .  "
510 PRINT AT R+1,20;" / \ "
520 PRINT AT R+2,20;"/---\"
530 REM MOON SURFACE
540 PRINT AT 21,0;"      .       .           .      .      "
550 PRINT AT 22,0;"  ___/ \_____/ \_________/ \____/ \____ "
560 PRINT AT 23,0;" /      \   /   \       /   \  /   \    "
570 RETURN
600 REM SUBROUTINE: SPEED GAUGE
610 LET VG=INT(ABS(V))
620 IF VG>20 THEN LET VG=20
630 PRINT AT 2,0;"SPEED: [";
640 FOR I=1 TO VG
650 PRINT "#";
660 NEXT I
670 FOR I=VG+1 TO 20
680 PRINT " ";
690 NEXT I
700 PRINT "]"
710 RETURN