10 REM Racer Game
20 DIM P(24)
30 LET L = 10
40 LET W = 15
50 FOR I = 1 TO 24
60 LET P(I) = L
70 NEXT I
80 LET C = L + W / 2
90 LET R_CAR = 15
100 LET S = 0
110 LET C_OLD = C
200 REM Main Loop
210 LET K$ = INKEY$
220 IF K$ = "a" OR K$ = "A" THEN LET C = C - 1
230 IF K$ = "d" OR K$ = "D" THEN LET C = C + 1
240 REM Update Road
250 LET R = RND
260 IF R < 0.3 AND L > 2 THEN LET L = L - 1
270 IF R > 0.7 AND L < 20 THEN LET L = L + 1
280 REM Shift History
290 FOR I = 1 TO 23
300 LET P(I) = P(I+1)
310 NEXT I
320 LET P(24) = L
330 REM Collision Check
340 IF C <= P(R_CAR) OR C >= (P(R_CAR) + W) THEN GOTO 500
350 REM Draw
360 SCROLL
370 PRINT TAB L; "|"; TAB (L + W); "|";
380 PRINT AT R_CAR-1, C_OLD; " "
390 PRINT AT R_CAR, C; "H"
400 LET C_OLD = C
410 LET S = S + 1
420 PAUSE 2
430 GOTO 200
500 PRINT AT 20, 0; "CRASH! SCORE: "; S
510 STOP