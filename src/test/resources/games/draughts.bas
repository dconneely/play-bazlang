# Draughts (Checkers)
# Play against the computer
5 RAND 0
10 REM Draughts
20 DIM B(8,8)
30 DIM TB(8,8)
40 DIM MV(100, 5)
50 DIM MV2(100, 5)
60 DIM H(8,8)
70 DIM L$(16, 20)
80 LET T = 1
90 LET MCV = 0
100 LET WN = 0
110 LET IG_F = 0
120 LET FORCE = 0
130 LET PL = 1
140 PRINT "PLAY AS BLACK (B) OR WHITE (W)?"
150 LET K$ = INKEY$
160 IF K$ = "" THEN GOTO 150
170 IF K$ = "b" THEN GOTO 210
180 IF K$ = "B" THEN GOTO 210
190 IF K$ = "w" THEN GOTO 240
200 IF K$ = "W" THEN GOTO 240
205 GOTO 150
210 LET P1 = 1
220 LET HC = 1
230 GOTO 260
240 LET P1 = 2
250 LET HC = 2
260 REM Init Board
270 FOR Y = 1 TO 8
280 FOR X = 1 TO 8
290 LET B(X,Y) = 0
300 LET P = 0
310 LET BG = (X + Y) - INT((X + Y) / 2) * 2
320 IF BG = 0 THEN GOTO 360
330 IF Y <= 3 THEN LET P = 2
340 IF Y >= 6 THEN LET P = 1
350 LET B(X,Y) = P
360 NEXT X
370 NEXT Y
380 FOR I = 1 TO 16
390 LET L$(I) = "                    "
400 NEXT I
410 REM Main Loop
420 GOSUB 1000
430 IF T = 1 THEN GOSUB 500
440 IF T = 2 THEN GOSUB 600
450 IF WN > 0 THEN GOTO 700
460 GOTO 410
500 REM Black Turn Entry
510 LET PL = 1
520 IF HC = 1 THEN GOSUB 2000
530 IF HC = 2 THEN GOSUB 3200
540 LET T = 2
550 GOSUB 4000
560 RETURN
600 REM White Turn Entry
610 LET PL = 2
620 IF HC = 2 THEN GOSUB 2000
630 IF HC = 1 THEN GOSUB 3200
640 LET T = 1
650 GOSUB 4000
660 RETURN
700 PRINT AT 23,0; "GAME OVER. WINNER: "; WN
710 STOP
1000 REM Draw Board Subroutine
1010 LET BL$ = CHR$(9608)
1020 PRINT AT 0,0; "   A   B   C   D   E   F   G   H      HISTORY"
1030 FOR Y = 1 TO 8
1040 LET YS$ = STR$(Y)
1050 LET YP = 1 + (Y - 1) * 2
1060 PRINT AT YP + 1, 0; YS$;
1070 PRINT AT YP + 1, 34; YS$;
1080 FOR X = 1 TO 8
1090 LET XP = 2 + (X - 1) * 4
1100 LET P = B(X,Y)
1110 LET BG = (X + Y) - INT((X + Y) / 2) * 2
1120 LET C$ = "    "
1130 IF BG = 0 THEN LET C$ = BL$ + BL$ + BL$ + BL$
1140 PRINT AT YP, XP; C$;
1150 IF BG = 1 THEN GOTO 1280
1160 PRINT AT YP + 1, XP; C$;
1170 GOTO 1360
1280 LET S$ = "    "
1282 IF P = 1 THEN LET S$ = " " + CHR$(11053) + "  "
1284 IF P = 2 THEN LET S$ = " " + CHR$(11052) + "  "
1286 IF P = 3 THEN LET S$ = " " + CHR$(9812) + "  "
1288 IF P = 4 THEN LET S$ = " " + CHR$(9818) + "  "
1290 IF H(X,Y) = 0 THEN GOTO 1350
1292 IF H(X,Y) <> 1 THEN GOTO 1320
1294 LET SY$ = CHR$(10710)
1296 IF T = 2 THEN LET SY$ = CHR$(10711)
1298 LET S$ = " " + SY$ + "  "
1300 GOTO 1350
1320 IF H(X,Y) = 2 THEN LET S$ = " ?  "
1330 IF H(X,Y) = 3 THEN LET S$ = " !  "
1350 PRINT AT YP + 1, XP; S$;
1360 NEXT X
1370 NEXT Y
1380 PRINT AT 17,0; "   A   B   C   D   E   F   G   H"
1390 FOR I = 1 TO 16
1400 PRINT AT I, 40; L$(I);
1410 NEXT I
1420 RETURN
2000 REM Human Move Subroutine
2010 LET PL = HC
2020 GOSUB 8000
2030 PRINT AT 19,0; "YOUR TURN (";
2040 IF HC = 1 THEN PRINT "BLACK)"
2050 IF HC = 2 THEN PRINT "WHITE)"
2060 LET IG_F = 0
2070 GOSUB 5000
2080 IF MC = 0 THEN LET WN = 3 - HC
2090 IF MC = 0 THEN RETURN
2100 REM Start Input
2110 PRINT AT 20,0; "MOVE:                                "
2120 LET MO$ = ""
2130 GOSUB 8200
2140 IF KX = 0 THEN RETURN
2150 LET SX = KX
2160 LET SY = KY
2170 LET V = 0
2180 FOR I = 1 TO MC
2190 IF MV(I,1) = SX THEN IF MV(I,2) = SY THEN LET V = 1
2200 NEXT I
2210 IF V = 1 THEN GOTO 2300
2220 LET P = B(SX,SY)
2230 IF P = 0 THEN PRINT AT 22,0; "EMPTY SQUARE      "
2240 IF P > 0 THEN IF (PL=1 AND (P=2 OR P=4)) OR (PL=2 AND (P=1 OR P=3)) THEN PRINT AT 22,0; "NOT YOUR PIECE    "
2250 IF P > 0 THEN IF (PL=1 AND (P=1 OR P=3)) OR (PL=2 AND (P=2 OR P=4)) THEN IF FORCE=1 THEN PRINT AT 22,0; "CAPTURE REQUIRED  "
2260 IF P > 0 THEN IF (PL=1 AND (P=1 OR P=3)) OR (PL=2 AND (P=2 OR P=4)) THEN IF FORCE=0 THEN PRINT AT 22,0; "NO LEGAL MOVES    "
2270 PAUSE 20
2280 GOTO 2110
2300 REM Chain Start
2310 LET S1$ = CHR$(SX + 64) + CHR$(SY + 48)
2320 LET MO$ = S1$
2330 FOR RY = 1 TO 8
2340 FOR RX = 1 TO 8
2350 LET TB(RX,RY) = B(RX,RY)
2360 NEXT RX
2370 NEXT RY
2380 GOSUB 8100
2390 LET H(SX,SY) = 1
2400 REM Chain Loop
2410 PRINT AT 20, 6; MO$;
2420 LET MC1 = MC
2430 FOR I = 1 TO MC1
2440 LET MV2(I,1) = MV(I,1)
2441 LET MV2(I,2) = MV(I,2)
2442 LET MV2(I,3) = MV(I,3)
2443 LET MV2(I,4) = MV(I,4)
2444 LET MV2(I,5) = MV(I,5)
2445 NEXT I
2450 LET IG_F = 1
2460 GOSUB 5000
2470 LET IG_F = 0
2480 FOR I = 1 TO MC
2490 IF MV(I,1) <> SX THEN GOTO 2550
2500 IF MV(I,2) <> SY THEN GOTO 2550
2510 LET TX = MV(I,3)
2511 LET TY = MV(I,4)
2512 LET OK = 0
2513 FOR J = 1 TO MC1
2514 IF MV2(J,1) = SX THEN IF MV2(J,2) = SY THEN IF MV2(J,3) = TX THEN IF MV2(J,4) = TY THEN LET OK = 1
2515 NEXT J
2516 LET H(TX,TY) = 3
2517 IF OK = 1 THEN LET H(TX,TY) = 2
2550 NEXT I
2560 GOSUB 1000
2570 PRINT AT 20, 6 + LEN(MO$); "-"
2580 GOSUB 8200
2590 IF KX = 0 THEN GOTO 2860
2600 LET DX = KX
2610 LET DY = KY
2620 LET MI = 0
2630 FOR I = 1 TO MC1
2640 IF MV2(I,1) = SX THEN IF MV2(I,2) = SY THEN IF MV2(I,3) = DX THEN IF MV2(I,4) = DY THEN LET MI = I
2650 NEXT I
2660 IF MI <> 0 THEN GOTO 2700
2670 PRINT AT 22,0; "INVALID DESTINATION      "
2680 PAUSE 20
2690 GOTO 2110
2700 REM Step Taken
2710 LET CAP = MV2(MI, 5)
2720 LET TB(DX,DY) = TB(SX,SY)
2730 LET TB(SX,SY) = 0
2740 IF CAP = 0 THEN GOTO 2780
2750 LET CX = (SX + DX) / 2
2760 LET CY = (SY + DY) / 2
2770 LET TB(CX,CY) = 0
2780 LET SX = DX
2790 LET SY = DY
2800 LET MO$ = MO$ + "-" + CHR$(DX + 64) + CHR$(DY + 48)
2810 LET H(SX,SY) = 1
2820 IF CAP = 0 THEN GOTO 2910
2830 GOSUB 5000
2840 IF FORCE = 1 THEN GOTO 2400
2850 GOTO 2910
2860 REM Cancel Handler
2870 GOSUB 8100
2880 GOSUB 1000
2890 GOSUB 8000
2900 GOTO 2110
2910 REM Submission Handler
2920 GOSUB 8100
2930 FOR RY = 1 TO 8
2940 FOR RX = 1 TO 8
2950 IF B(RX,RY) <> TB(RX,RY) THEN LET H(RX,RY) = 1
2960 NEXT RX
2970 NEXT RY
2980 GOSUB 1000
2990 PRINT AT 22,0; "PRESS ENTER TO SUBMIT"
3000 LET K$ = INKEY$
3010 IF K$ = CHR$(13) THEN GOTO 3050
3020 IF K$ = CHR$(27) THEN GOTO 2860
3030 IF K$ = "" THEN GOTO 3000
3040 GOTO 3000
3050 FOR RY = 1 TO 8
3055 FOR RX = 1 TO 8
3060 LET B(RX,RY) = TB(RX,RY)
3065 NEXT RX
3070 NEXT RY
3075 IF B(DX,DY) = 1 THEN IF DY = 1 THEN LET B(DX,DY) = 3
3080 IF B(DX,DY) = 2 THEN IF DY = 8 THEN LET B(DX,DY) = 4
3085 LET MCV = MCV + 1
3090 LET N$ = STR$(MCV)
3095 LET COL$ = "B"
3100 IF HC = 2 THEN LET COL$ = "W"
3105 LET M$ = N$ + ". HUM: " + COL$ + " " + MO$
3110 GOSUB 7000
3115 GOSUB 8100
3120 GOSUB 8000
3125 RETURN
3200 REM AI Turn Subroutine
3210 GOSUB 8000
3220 PRINT AT 19,0; "AI THINKING..."
3230 PAUSE 20
3240 LET PL = 3 - HC
3250 LET IG_F = 0
3260 GOSUB 5000
3270 IF MC = 0 THEN LET WN = HC
3280 IF MC = 0 THEN RETURN
3290 LET BEST_I = 1
3300 LET BEST_V = -9999
3310 FOR I = 1 TO MC
3320 LET VV = 0
3330 IF MV(I,5) = 1 THEN LET VV = 100
3340 LET VV = VV + RND
3350 IF VV <= BEST_V THEN GOTO 3380
3360 LET BEST_V = VV
3370 LET BEST_I = I
3380 NEXT I
3390 LET I = BEST_I
3400 GOSUB 6000
3410 LET MCV = MCV + 1
3420 LET C1$ = CHR$(MV(I,1) + 64)
3425 LET R1$ = CHR$(MV(I,2) + 48)
3430 LET S1$ = C1$ + R1$
3440 LET C2$ = CHR$(MV(I,3) + 64)
3445 LET R2$ = CHR$(MV(I,4) + 48)
3450 LET S2$ = C2$ + R2$
3460 LET N$ = STR$(MCV)
3470 LET COL$ = "W"
3480 IF HC = 2 THEN LET COL$ = "B"
3490 LET M$ = N$ + ". AI : " + COL$ + " " + S1$ + "-" + S2$
3500 GOSUB 7000
3510 GOSUB 8000
3520 RETURN
4000 REM Check Win Subroutine
4010 LET C1 = 0
4020 LET C2 = 0
4030 FOR CY = 1 TO 8
4040 FOR CX = 1 TO 8
4050 LET P = B(CX,CY)
4060 IF P = 1 OR P = 3 THEN LET C1 = C1 + 1
4070 IF P = 2 OR P = 4 THEN LET C2 = C2 + 1
4080 NEXT CX
4090 NEXT CY
4100 IF C1 = 0 THEN LET WN = 2
4110 IF C2 = 0 THEN LET WN = 1
4120 RETURN
5000 REM Get Moves Engine
5010 LET MC = 0
5020 LET FORCE = 0
5030 FOR GY = 1 TO 8
5040 FOR GX = 1 TO 8
5050 LET P = B(GX,GY)
5060 IF P = 0 THEN GOTO 5100
5070 IF PL = 1 AND (P = 2 OR P = 4) THEN GOTO 5100
5080 IF PL = 2 AND (P = 1 OR P = 3) THEN GOTO 5100
5090 IF P = 1 OR P = 3 OR P = 4 THEN LET GDY = -1
5092 IF P = 1 OR P = 3 OR P = 4 THEN GOSUB 5300
5094 IF P = 2 OR P = 3 OR P = 4 THEN LET GDY = 1
5096 IF P = 2 OR P = 3 OR P = 4 THEN GOSUB 5300
5100 NEXT GX
5110 NEXT GY
5120 IF IG_F = 1 OR FORCE = 0 THEN RETURN
5130 LET GJ = 0
5140 FOR GI = 1 TO MC
5150 IF MV(GI,5) <> 1 THEN GOTO 5200
5160 LET GJ = GJ + 1
5170 FOR GK = 1 TO 5
5180 LET MV(GJ,GK) = MV(GI,GK)
5190 NEXT GK
5200 NEXT GI
5210 LET MC = GJ
5220 RETURN
5300 REM Dir Check
5310 FOR GDX = -1 TO 1 STEP 2
5320 LET GTX = GX + GDX
5330 LET GTY = GY + GDY
5340 IF GTX < 1 OR GTX > 8 OR GTY < 1 OR GTY > 8 THEN GOTO 5390
5350 LET GTP = B(GTX,GTY)
5360 IF GTP = 0 THEN IF FORCE = 0 THEN LET MC = MC + 1
5362 IF GTP = 0 THEN IF FORCE = 0 THEN LET MV(MC,1)=GX
5364 IF GTP = 0 THEN IF FORCE = 0 THEN LET MV(MC,2)=GY
5366 IF GTP = 0 THEN IF FORCE = 0 THEN LET MV(MC,3)=GTX
5368 IF GTP = 0 THEN IF FORCE = 0 THEN LET MV(MC,4)=GTY
5369 IF GTP = 0 THEN IF FORCE = 0 THEN LET MV(MC,5)=0
5370 IF GTP = 0 THEN GOTO 5390
5380 IF (PL = 1 AND (GTP = 2 OR GTP = 4)) OR (PL = 2 AND (GTP = 1 OR GTP = 3)) THEN GOSUB 5500
5390 NEXT GDX
5400 RETURN
5500 REM Jump Check
5510 LET GJX = GTX + GDX
5520 LET GJY = GTY + GDY
5530 IF GJX < 1 OR GJX > 8 OR GJY < 1 OR GJY > 8 THEN RETURN
5540 IF B(GJX,GJY) <> 0 THEN RETURN
5550 LET MC = MC + 1
5560 LET MV(MC,1) = GX
5570 LET MV(MC,2) = GY
5580 LET MV(MC,3) = GJX
5590 LET MV(MC,4) = GY
5600 LET MV(MC,5) = 1
5610 LET FORCE = 1
5620 RETURN
6000 REM Apply Move Subroutine
6010 LET SX = MV(I,1)
6020 LET SY = MV(I,2)
6030 LET DX = MV(I,3)
6040 LET DY = MV(I,4)
6050 LET CAP = MV(I,5)
6060 LET B(DX,DY) = B(SX,SY)
6070 LET B(SX,SY) = 0
6080 IF CAP = 0 THEN GOTO 6120
6090 LET CX = (SX + DX) / 2
6100 LET CY = (SY + DY) / 2
6110 LET B(CX,CY) = 0
6120 IF B(DX,DY) = 1 AND DY = 1 THEN LET B(DX,DY) = 3
6130 IF B(DX,DY) = 2 AND DY = 8 THEN LET B(DX,DY) = 4
6140 RETURN
7000 REM Add to Log Subroutine
7010 FOR LI = 1 TO 15
7020 LET L$(LI) = L$(LI + 1)
7030 NEXT LI
7040 LET L$(16) = M$
7050 RETURN
8000 REM Clear UI Utility
8010 PRINT AT 19,0; "                                        "
8020 PRINT AT 20,0; "                                        "
8030 PRINT AT 21,0; "                                        "
8040 PRINT AT 22,0; "                                        "
8050 RETURN
8100 REM Clear Highlights Utility
8110 FOR HY = 1 TO 8
8120 FOR HX = 1 TO 8
8130 LET H(HX,HY) = 0
8140 NEXT HX
8150 NEXT HY
8160 RETURN
8200 REM Input Coordinate Utility
8210 LET K$ = INKEY$
8220 IF K$ = "" THEN GOTO 8210
8230 IF K$ = CHR$(27) THEN LET KX = 0
8235 IF K$ = CHR$(27) THEN RETURN
8240 LET CI = CODE(K$)
8250 IF CI >= 97 THEN LET CI = CI - 32
8260 IF CI < 65 OR CI > 72 THEN GOTO 8210
8270 LET KX = CI - 64
8280 PRINT CHR$(CI);
8290 LET K$ = INKEY$
8300 IF K$ = "" THEN GOTO 8290
8310 IF K$ = CHR$(27) THEN LET KX = 0
8315 IF K$ = CHR$(27) THEN RETURN
8320 LET CI = CODE(K$)
8330 IF CI < 49 OR CI > 56 THEN GOTO 8290
8340 LET KY = CI - 48
8350 PRINT CHR$(CI);
8360 RETURN
