# Sieve of Eratosthenes
10 PRINT "SIEVE OF ERATOSTHENES"
20 DIM A(100)
30 FOR I = 1 TO 100
40   LET A(I) = 1
50 NEXT I
60 FOR I = 2 TO 10
70   IF A(I) = 0 THEN GOTO 110
80   FOR J = I * I TO 100 STEP I
90     LET A(J) = 0
100  NEXT J
110 NEXT I
120 PRINT "PRIMES UP TO 100:"
130 FOR I = 2 TO 100
140   IF A(I) = 1 THEN PRINT I; " ";
150 NEXT I
160 PRINT
